<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ProyectoPrimeraEvaluacion_Izaro.ViewModels"
             mc:Ignorable="d"
             x:Class="ProyectoPrimeraEvaluacion_Izaro.Views.Dialogs.EditDialog"
             x:DataType="vm:ConsultPerfumesViewModel">
    
    <Design.DataContext>
        <vm:ConsultPerfumesViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="100, 50, 80, 50, 50, 50, 70, *">

        <!-- Título -->
        <TextBlock Grid.Row="0"
                   Text="EDITAR PERFUME"
                   FontSize="32"
                   Foreground="#9D8189"
                   HorizontalAlignment="Center"
                   Margin="0,10"/>

        <!-- Código -->
        <TextBox Grid.Row="1"
                 Width="250"
                 Height="40"
                 Watermark="Código"
                 Text="{Binding }"
                 HorizontalAlignment="Center"/>

        <!-- Descripción -->
        <TextBox Grid.Row="2"
                 Width="250"
                 Height="60"
                 Watermark="Descripción"
                 Text="{Binding }"
                 HorizontalAlignment="Center"/>

        <!-- Marca -->
        <ComboBox Grid.Row="3"
                  Width="250"
                  Height="40"
                  SelectedItem="{Binding }"
                  HorizontalAlignment="Center"/>

        <!-- Edición limitada -->
        <CheckBox Grid.Row="4"
                  Content="Edición limitada"
                  IsChecked="{Binding IsLimited}"
                  HorizontalAlignment="Center"/>

        <!-- Fecha -->
        <CalendarDatePicker Grid.Row="5"
                            Width="250"
                            SelectedDate="{Binding }"
                            HorizontalAlignment="Center"/>

        <!-- Cantidad -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
            <TextBlock Text="Cantidad (ml)" FontSize="16"/>
            <Slider Width="120"
                    Minimum="0"
                    Maximum="300"
                    Value="{Binding }"/>
        </StackPanel>

        <!-- Botones -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
            <Button Content="Aceptar"
                    Width="120" Height="40"
                    Command="{Binding}"/>

            <Button Content="Cancelar"
                    Width="120" Height="40"
                    Command="{Binding CloseEditDialogCommand}"/>
        </StackPanel>

    </Grid>

</UserControl>
