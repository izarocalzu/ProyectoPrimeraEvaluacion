<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ProyectoPrimeraEvaluacion_Izaro.ViewModels"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProyectoPrimeraEvaluacion_Izaro.Views.CreatePerfumeView"
             x:DataType="vm:CreatePerfumeViewModel">

    <Design.DataContext>
        <vm:CreatePerfumeViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="100, 50, 90, 50, 50, 50, 50, *">

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FDDCDC" Offset="0.0"/>
                <GradientStop Color="#EADFFD" Offset="0.5"/>
                <GradientStop Color="#F4CCCC" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel Grid.Row="0" VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
            <TextBlock Text="NUEVO PERFUME"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="#5A4D59"
                       Margin="0,5,0,10" />
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBox Width="250" Height="45"
                     Watermark="Código"
                     Text="{Binding ProductCode}"
                     HorizontalAlignment="Center"
                     VerticalContentAlignment="Center"
                     FontSize="18"
                     Foreground="#5A4D59"
                     BorderBrush="#D4A0A7"
                     BorderThickness="1"
                     CornerRadius="5"/>
        </StackPanel>

        <StackPanel Grid.Row="2" VerticalAlignment="Center">
            <TextBox Width="250" Height="65"
                     Watermark="Descripción"
                     Text="{Binding ProductDescription}"
                     HorizontalAlignment="Center" 
                     FontSize="18"
                     Foreground="#5A4D59"
                     BorderBrush="#D4A0A7"
                     BorderThickness="1"
                     CornerRadius="5"/>
        </StackPanel>

        <StackPanel Grid.Row="3" VerticalAlignment="Center">
            <ComboBox Width="250" Height="45"
                      PlaceholderText="Marca"
                      ItemsSource="{Binding MarcasList}"
                      SelectedItem="{Binding SelectedBrand}"
                      VerticalContentAlignment="Center"
                      HorizontalAlignment="Center" 
                      FontSize="18"
                      Foreground="#5A4D59"
                      BorderBrush="#D4A0A7"
                      BorderThickness="1"
                      CornerRadius="5"/>
        </StackPanel>

        <StackPanel Grid.Row="4" VerticalAlignment="Center">
            <CheckBox Content="Edición limitada"
                      IsChecked="{Binding IsLimitedEdition}"
                      HorizontalAlignment="Center" 
                      FontSize="18"
                      Foreground="#5A4D59"/>
        </StackPanel>

        <StackPanel Grid.Row="5" VerticalAlignment="Center">
            <CalendarDatePicker Width="250" Height="45"
                                SelectedDate="{Binding CreationDate}"
                                HorizontalAlignment="Center" 
                                FontSize="18"
                                Foreground="#5A4D59"
                                BorderBrush="#D4A0A7"
                                BorderThickness="1"
                                CornerRadius="5"/>
        </StackPanel>

        <StackPanel Grid.Row="6" VerticalAlignment="Center">
            <TextBlock Text="Cantidad (ml):" HorizontalAlignment="Center"
                       FontSize="18"
                       Foreground="#5A4D59"
                       Margin="10"/>
            <Slider Width="100"
                    Value="{Binding VolumeValue}"
                    Foreground="#E57F90"/> 
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="20">

            <Button Content="Aceptar"
                    Command="{Binding CreateNewPerfumeCommand}"
                    CommandParameter="consult"
                    HorizontalContentAlignment="Center"
                    FontSize="20"
                    Width="150" Height="45"
                    Background="#E57F90"
                    Foreground="#FDFDFD"
                    BorderBrush="#D4A0A7"
                    BorderThickness="1"
                    CornerRadius="5"
                    FontWeight="SemiBold"/>

            <Button Content="Cancelar"
                    Command="{Binding CancelCreateCommand}"
                    HorizontalContentAlignment="Center"
                    FontSize="20"
                    Width="150" Height="45" 
                    Background="#E57F90"
                    Foreground="#FDFDFD"
                    BorderBrush="#D4A0A7"
                    BorderThickness="1"
                    CornerRadius="5"
                    FontWeight="SemiBold"/>

        </StackPanel>

    </Grid>

</UserControl>